<Application x:Class="OpenFinalShell.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources><ResourceDictionary>
    <Style x:Key="ActivityButtonStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="SettingsNavigationButtonStyle" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <!-- Safe startup fallbacks when an unpackaged publish omits an optional
         platform theme dictionary. The platform dictionary overrides these. -->
    <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FF272727" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#33444444" />
    <ResourceDictionary.MergedDictionaries>
      <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
    </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary></Application.Resources>
</Application>
