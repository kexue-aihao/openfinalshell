<Application x:Class="OpenFinalShell.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources><ResourceDictionary>
    <DataTemplate x:Key="NativeConnectionTreeNodeTemplate"><ContentPresenter Content="{Binding Content}" /></DataTemplate>
    <Style x:Key="ActivityButtonStyle" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="EditorToolbarButtonStyle" TargetType="Button"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="5"/><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="EditorToolbarToggleStyle" TargetType="ToggleButton"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,0"/><Setter Property="CornerRadius" Value="5"/><Setter Property="UseSystemFocusVisuals" Value="True"/></Style>
    <Style x:Key="SettingsNavigationButtonStyle" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <!-- Safe startup fallbacks when an unpackaged publish omits an optional
         platform theme dictionary. The platform dictionary overrides these. -->
    <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FF272727" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#33444444" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FF272727" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#FFD7D7D7" />
    <SolidColorBrush x:Key="EditorGutterBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="EditorGutterForegroundBrush" Color="#FF8B8B8B" />
    <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#FF314B65" />
    <SolidColorBrush x:Key="EditorSelectionForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="EditorCommentForegroundBrush" Color="#FF98C28B" />
    <SolidColorBrush x:Key="EditorKeywordForegroundBrush" Color="#FFC6A1E7" />
    <SolidColorBrush x:Key="EditorLiteralForegroundBrush" Color="#FFE5C391" />
    <ResourceDictionary.MergedDictionaries>
      <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
    </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary></Application.Resources>
</Application>
