<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <Thickness x:Key="CardPadding">16</Thickness>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFF3F3F3" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FFFBFBFB" /></ResourceDictionary>
    <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FF202020" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FF272727" /></ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
