<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <Thickness x:Key="CardPadding">16</Thickness>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFF3F3F3" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FFFBFBFB" /><SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFBFBFB" /><SolidColorBrush x:Key="EditorForegroundBrush" Color="#FF202020" /><SolidColorBrush x:Key="EditorGutterBrush" Color="#FFF3F3F3" /><SolidColorBrush x:Key="EditorGutterForegroundBrush" Color="#FF606060" /><SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#FFF4F4F4" /><SolidColorBrush x:Key="EditorSelectionBrush" Color="#FFF5D6B3" /><SolidColorBrush x:Key="EditorSelectionForegroundBrush" Color="#FF202020" /></ResourceDictionary>
    <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FF202020" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FF272727" /><SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FF272727" /><SolidColorBrush x:Key="EditorForegroundBrush" Color="#FFD7D7D7" /><SolidColorBrush x:Key="EditorGutterBrush" Color="#FF202020" /><SolidColorBrush x:Key="EditorGutterForegroundBrush" Color="#FF8B8B8B" /><SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#FF333333" /><SolidColorBrush x:Key="EditorSelectionBrush" Color="#FF4A3A30" /><SolidColorBrush x:Key="EditorSelectionForegroundBrush" Color="#FFFFFFFF" /></ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="EditorBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="EditorForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" /><SolidColorBrush x:Key="EditorGutterBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="EditorGutterForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" /><SolidColorBrush x:Key="EditorCurrentLineBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="EditorSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" /><SolidColorBrush x:Key="EditorSelectionForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" /></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
