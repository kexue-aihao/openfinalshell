<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
  <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="NavigationSelectionCornerRadius">0</CornerRadius>
  <Thickness x:Key="CardPadding">16</Thickness>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFF0F0F0" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FFFFFFFF" /><SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFFFF" /><SolidColorBrush x:Key="EditorForegroundBrush" Color="#FF202020" /><SolidColorBrush x:Key="EditorGutterBrush" Color="#FFF0F0F0" /><SolidColorBrush x:Key="EditorGutterForegroundBrush" Color="#FF606060" /><SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#FFF4F4F4" /><SolidColorBrush x:Key="EditorSelectionBrush" Color="#FFDCEBFA" /><SolidColorBrush x:Key="EditorSelectionForegroundBrush" Color="#FF202020" /></ResourceDictionary>
    <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FF1F1F1F" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FF252525" /><SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FF252525" /><SolidColorBrush x:Key="EditorForegroundBrush" Color="#FFD7D7D7" /><SolidColorBrush x:Key="EditorGutterBrush" Color="#FF1F1F1F" /><SolidColorBrush x:Key="EditorGutterForegroundBrush" Color="#FF8B8B8B" /><SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#FF333333" /><SolidColorBrush x:Key="EditorSelectionBrush" Color="#FF314B65" /><SolidColorBrush x:Key="EditorSelectionForegroundBrush" Color="#FFFFFFFF" /></ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="EditorBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="EditorForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" /><SolidColorBrush x:Key="EditorGutterBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="EditorGutterForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" /><SolidColorBrush x:Key="EditorCurrentLineBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="EditorSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" /><SolidColorBrush x:Key="EditorSelectionForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" /></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
