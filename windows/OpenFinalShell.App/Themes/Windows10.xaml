<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
  <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
  <Thickness x:Key="CardPadding">16</Thickness>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFF0F0F0" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FFFFFFFF" /></ResourceDictionary>
    <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FF1F1F1F" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FF252525" /></ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" /></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
