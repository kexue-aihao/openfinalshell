<Window x:Class="OpenFinalShell.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="ZoomViewport" SizeChanged="ZoomHostSizeChanged">
   <Grid x:Name="Root" Background="{ThemeResource ShellBackgroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0" AutomationProperties.Name="OpenFinalShell Native Workbench" AutomationProperties.AutomationId="native-workbench">
    <Grid.RenderTransform><ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Grid x:Name="ShellTitleBar" Grid.Row="0" Background="{ThemeResource ShellBackgroundBrush}" SizeChanged="TitleBarSizeChanged" AutomationProperties.Name="Title and session tabs">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition x:Name="CaptionButtonsColumn" Width="138"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="TitleBrand" Orientation="Horizontal" Spacing="8" Padding="12,0" VerticalAlignment="Center"><Image Source="Assets/OpenFinalShell.png" Width="20" Height="20"/><TextBlock Text="OpenFinalShell" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <TabView x:Name="Sessions" Grid.Column="1" IsAddTabButtonVisible="True" AddTabButtonClick="AddSessionRequested" TabWidthMode="SizeToContent" CanReorderTabs="False" TabCloseRequested="SessionCloseRequested" SelectionChanged="SessionSelectionChanged" VerticalAlignment="Bottom" MinHeight="0" Height="36" Padding="0"/>
     <Grid x:Name="TitleBarDragRegion" Grid.Column="2" Background="Transparent"/>
    </Grid>
    <InfoBar Grid.Row="1" x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning" />
    <Grid x:Name="Body" Grid.Row="2" SizeChanged="WorkbenchSizeChanged">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="48"/>
      <ColumnDefinition x:Name="ContextSidebarColumn" Width="300" MinWidth="0" MaxWidth="460"/>
      <ColumnDefinition x:Name="ContextSidebarSplitterColumn" Width="6"/>
      <ColumnDefinition x:Name="MainWorkspaceColumn" Width="*" MinWidth="236"/>
     </Grid.ColumnDefinitions>

     <Grid x:Name="ActivityRail" Grid.Column="0" Padding="5,8" RowSpacing="4" Background="{ThemeResource ShellBackgroundBrush}" AutomationProperties.Name="Activity bar">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="4">
       <Button x:Name="ConnectionsItem" Tag="connections" Click="ActivityItemClicked" Width="38" Height="38" Padding="0" Style="{StaticResource ActivityButtonStyle}" AutomationProperties.Name="Connections"><Grid><Border x:Name="ConnectionsSelection" CornerRadius="{ThemeResource NavigationSelectionCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed"/><Border x:Name="ConnectionsMarker" Width="3" Height="24" Margin="-5,0,0,0" HorizontalAlignment="Left" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/><FontIcon x:Name="ConnectionsIcon" FontSize="20"/></Grid></Button>
       <Button x:Name="CommandsItem" Tag="commands" Click="ActivityItemClicked" Width="38" Height="38" Padding="0" Style="{StaticResource ActivityButtonStyle}" AutomationProperties.Name="Commands"><Grid><Border x:Name="CommandsSelection" CornerRadius="{ThemeResource NavigationSelectionCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed"/><Border x:Name="CommandsMarker" Width="3" Height="24" Margin="-5,0,0,0" HorizontalAlignment="Left" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/><Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 5,5 L 11,10 L 5,15 M 13,15 L 18,15" Stroke="{Binding Foreground, ElementName=CommandsItem}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Grid></Button>
       <Button x:Name="ForwardItem" Tag="forwards" Click="ActivityItemClicked" Width="38" Height="38" Padding="0" Style="{StaticResource ActivityButtonStyle}" AutomationProperties.Name="Port forwarding"><Grid><Border x:Name="ForwardSelection" CornerRadius="{ThemeResource NavigationSelectionCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed"/><Border x:Name="ForwardMarker" Width="3" Height="24" Margin="-5,0,0,0" HorizontalAlignment="Left" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/><FontIcon x:Name="ForwardIcon" FontSize="20"/></Grid></Button>
       <Button x:Name="TransfersItem" Tag="transfers" Click="ActivityItemClicked" Width="38" Height="38" Padding="0" Style="{StaticResource ActivityButtonStyle}" AutomationProperties.Name="Transfers"><Grid><Border x:Name="TransfersSelection" CornerRadius="{ThemeResource NavigationSelectionCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed"/><Border x:Name="TransfersMarker" Width="3" Height="24" Margin="-5,0,0,0" HorizontalAlignment="Left" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/><FontIcon x:Name="TransfersIcon" FontSize="20"/></Grid></Button>
       <Button x:Name="AiItem" Tag="ai" Click="ActivityItemClicked" Width="38" Height="38" Padding="0" Style="{StaticResource ActivityButtonStyle}" AutomationProperties.Name="AI assistant"><Grid><Border x:Name="AiSelection" CornerRadius="{ThemeResource NavigationSelectionCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed"/><FontIcon x:Name="AiIcon" FontSize="20"/></Grid></Button>
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="4">
       <Button x:Name="ThemeItem" Tag="theme" Click="ActivityItemClicked" Width="38" Height="38" Padding="0" Style="{StaticResource ActivityButtonStyle}" AutomationProperties.Name="Toggle theme"><Grid><Border x:Name="ThemeSelection" CornerRadius="{ThemeResource NavigationSelectionCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed"/><FontIcon x:Name="ThemeIcon" FontSize="20"/></Grid></Button>
       <Button x:Name="SettingsItem" Tag="settings" Click="ActivityItemClicked" Width="38" Height="38" Padding="0" Style="{StaticResource ActivityButtonStyle}" AutomationProperties.Name="Settings"><Grid><Border x:Name="SettingsSelection" CornerRadius="{ThemeResource NavigationSelectionCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed"/><FontIcon x:Name="SettingsIcon" FontSize="20"/></Grid></Button>
      </StackPanel>
     </Grid>

     <Grid x:Name="MainWorkspace" Grid.Column="3" Background="{ThemeResource WorkspaceBackgroundBrush}" AutomationProperties.Name="Session workspace">
      <Grid x:Name="SessionArea">
              <ContentControl x:Name="SessionContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
       <ScrollViewer x:Name="WelcomePage" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" SizeChanged="WelcomeSizeChanged">
        <Grid x:Name="WelcomeViewport"><StackPanel MaxWidth="1024" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="32" Spacing="10">
         <Image Source="Assets/OpenFinalShell.png" Width="72" Height="72" HorizontalAlignment="Center"/>
         <TextBlock x:Name="WelcomeTitle" Text="OpenFinalShell" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
         <TextBlock x:Name="WelcomeDescription" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Opacity="0.72" MaxWidth="680" HorizontalAlignment="Center" Margin="0,0,0,20"/>
         <Grid x:Name="WelcomeCards" ColumnSpacing="16" RowSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Button x:Name="WelcomeNewButton" Grid.Column="0" Click="NewConnection" MinHeight="156" Padding="20" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="{ThemeResource CardCornerRadius}">
           <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16"/><TextBlock x:Name="WelcomeNewTitle" FontSize="14" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="WelcomeNewDescription" FontSize="12" TextWrapping="Wrap" Opacity="0.72"/></StackPanel>
          </Button>
          <Border x:Name="WelcomeQuickCard" Grid.Column="1" MinHeight="156" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource CardCornerRadius}">
           <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE945;" FontSize="16"/><TextBlock x:Name="QuickConnectHeading" FontSize="14" FontWeight="SemiBold"/></StackPanel><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="QuickConnectInput" KeyDown="QuickConnectKeyDown" MinWidth="0" FontSize="12"/><Button x:Name="QuickConnectButton" Grid.Column="1" Click="QuickConnect" Padding="10,5"/></Grid></StackPanel>
          </Border>
          <Border x:Name="WelcomeRecentCard" Grid.Column="2" MinHeight="156" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource CardCornerRadius}">
           <StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE81C;" FontSize="16"/><TextBlock x:Name="RecentHeading" FontSize="14" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="RecentEmptyText" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/><ListView x:Name="RecentConnections" IsItemClickEnabled="True" ItemClick="OpenConnection" DisplayMemberPath="Name" MaxHeight="132"/></StackPanel>
          </Border>
         </Grid>
         <Button x:Name="WelcomeImportButton" Click="ImportData" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel></Grid>
       </ScrollViewer>
      </Grid>
     </Grid>

     <Grid x:Name="ContextSidebar" Grid.Column="1" RowSpacing="6" Padding="8,0,8,10" Background="{ThemeResource WorkspaceBackgroundBrush}" HorizontalAlignment="Stretch" AutomationProperties.Name="Context sidebar">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="ContextHeading" Height="36" VerticalAlignment="Center" Padding="4,8,0,0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <Grid x:Name="SidebarPages" Grid.Row="1">
       <Grid x:Name="ConnectionSidebarPage" Visibility="Visible" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <ContentControl x:Name="ConnectionTreeHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Button x:Name="ConnectionViewOptionsButton" Grid.Row="2" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE71C;" FontSize="14"/><Button.Flyout><Flyout><StackPanel Width="240" Spacing="8"><CommandBar x:Name="ConnectionCommands" DefaultLabelPosition="Collapsed" HorizontalAlignment="Stretch" IsDynamicOverflowEnabled="True">
         <AppBarButton x:Name="NewButton" Icon="Add" Click="NewConnection"/>
         <AppBarButton x:Name="EditButton" Icon="Edit" Click="EditConnection"/>
         <AppBarButton x:Name="DuplicateButton" Icon="Copy" Click="DuplicateConnection"/>
         <AppBarButton x:Name="DeleteButton" Icon="Delete" Click="DeleteConnection"/>
         <CommandBar.SecondaryCommands>
          <AppBarButton x:Name="ReconnectButton" Click="ReconnectSession"/>
          <AppBarButton x:Name="ImportButton" Click="ImportData"/>
          <AppBarButton x:Name="MigrationImportButton" Click="ImportData" Visibility="Collapsed"/>
          <AppBarButton x:Name="ExportButton" Click="ExportData"/>
         </CommandBar.SecondaryCommands>
        </CommandBar><ComboBox x:Name="ConnectionSortChoice" HorizontalAlignment="Stretch" SelectionChanged="ConnectionSortChanged"/><ComboBox x:Name="ConnectionGroupingChoice" HorizontalAlignment="Stretch" SelectionChanged="ConnectionGroupingChanged"/></StackPanel></Flyout></Button.Flyout></Button>
        <ListView x:Name="ProfilesList" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="ProfileSelectionChanged"/>
       </Grid>

       <Grid x:Name="TransfersPage" Visibility="Collapsed" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="TransferSummary" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Transfer totals"/>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="True"><AppBarButton Icon="Pause" x:Name="PauseAllTransfersButton" Click="PauseAllTransfers"/><AppBarButton Icon="Cancel" x:Name="CancelAllTransfersButton" Click="CancelAllTransfers"/><AppBarButton Icon="Clear" x:Name="ClearTransferButton" Click="ClearFinishedTransfers"/><CommandBar.SecondaryCommands><AppBarButton Icon="Pause" x:Name="PauseTransferButton" Click="PauseTransfer"/><AppBarButton Icon="Play" x:Name="ResumeTransferButton" Click="ResumeTransfer"/><AppBarButton Icon="Refresh" x:Name="RetryTransferButton" Click="RetryTransfer"/><AppBarButton Icon="Cancel" x:Name="CancelTransferButton" Click="CancelTransfer"/><AppBarButton Icon="OpenLocal" x:Name="OpenTransferLocationButton" Click="OpenTransferLocation"/></CommandBar.SecondaryCommands></CommandBar>
        <ListView x:Name="TransferList" Grid.Row="2" SelectionMode="Single" SelectionChanged="TransferSelectionChanged" AutomationProperties.Name="Transfer queue">
         <ListView.ItemTemplate>
          <DataTemplate>
           <StackPanel Padding="8,6" Spacing="4">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Opacity="0.72">
             <Run Text="{Binding Source}"/><Run Text=" → "/><Run Text="{Binding Target}"/>
            </TextBlock>
            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.68">
             <Run Text="{Binding CompletedBytes}"/><Run Text=" / "/><Run Text="{Binding TotalBytes}"/>
            </TextBlock>
           </StackPanel>
          </DataTemplate>
         </ListView.ItemTemplate>
        </ListView>
       </Grid>

       <Grid x:Name="CommandsPage" Visibility="Collapsed" RowSpacing="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="96"/></Grid.RowDefinitions>
        <TextBox x:Name="CommandSearch" TextChanged="CommandSearchChanged"/>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="True"><AppBarButton Icon="Add" x:Name="NewSnippetButton" Click="NewCommandSnippet"/><AppBarButton Icon="Send" x:Name="SendSnippetButton" Click="SendSelectedSnippet"/><AppBarButton Icon="Edit" x:Name="ComposeCommandButton" Click="ComposeCommand"/><AppBarButton Icon="Find" x:Name="FindDuplicateCommandsButton" Click="FindDuplicateCommands"/><CommandBar.SecondaryCommands><AppBarButton Icon="NewFolder" x:Name="NewGroupButton" Click="NewCommandGroup"/><AppBarButton Icon="Edit" x:Name="EditGroupButton" Click="EditCommandGroup"/><AppBarButton Icon="Delete" x:Name="DeleteGroupButton" Click="DeleteCommandGroup"/><AppBarButton Icon="Edit" x:Name="EditSnippetButton" Click="EditCommandSnippet"/><AppBarButton Icon="Copy" x:Name="DuplicateSnippetButton" Click="DuplicateCommandSnippet"/><AppBarButton Icon="Delete" x:Name="DeleteSnippetButton" Click="DeleteCommandSnippet"/><AppBarButton Icon="Clear" x:Name="ClearHistoryButton" Click="ClearCommandHistory"/></CommandBar.SecondaryCommands></CommandBar>
        <Grid Grid.Row="2" RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="CommandGroupsHeading" VerticalAlignment="Center"/><Button x:Name="CommandGroupMoveUp" Content="↑" Click="MoveCommandGroupUp"/><Button x:Name="CommandGroupMoveDown" Content="↓" Click="MoveCommandGroupDown"/></StackPanel><ListView x:Name="CommandGroups" Grid.Row="1" ItemsSource="{x:Bind CommandViewModel.Groups}" DisplayMemberPath="Name" SelectionChanged="CommandGroupChanged" AutomationProperties.Name="Command groups"/></Grid>
        <Grid Grid.Row="3" RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="CommandMoveUp" Content="↑" Click="MoveCommandUp"/><Button x:Name="CommandMoveDown" Content="↓" Click="MoveCommandDown"/></StackPanel><ListView x:Name="CommandSnippets" Grid.Row="1" ItemsSource="{x:Bind CommandViewModel.Snippets}" DisplayMemberPath="Name" SelectionChanged="CommandSnippetChanged" IsItemClickEnabled="True" ItemClick="CommandSnippetClicked" RightTapped="CommandSnippetRightTapped" KeyDown="CommandSnippetKeyDown" AutomationProperties.Name="Commands"/></Grid>
        <TextBlock x:Name="CommandHistoryHeading" Grid.Row="4" Margin="8,8,8,0" FontWeight="SemiBold"/>
        <ListView x:Name="CommandHistory" Grid.Row="5" ItemsSource="{x:Bind CommandViewModel.History}" IsItemClickEnabled="True" ItemClick="RefillCommandHistory"/>
       </Grid>

       <Grid x:Name="ForwardPage" Visibility="Collapsed" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="True"><AppBarButton Icon="Add" x:Name="NewForwardButton" Click="NewForward"/><AppBarButton Icon="Play" x:Name="StartForwardButton" Click="StartForward"/><AppBarButton Icon="Stop" x:Name="StopForwardButton" Click="StopForward"/><CommandBar.SecondaryCommands><AppBarButton Icon="Edit" x:Name="EditForwardButton" Click="EditForward"/><AppBarButton Icon="Delete" x:Name="DeleteForwardButton" Click="DeleteForward"/><AppBarButton Icon="Refresh" x:Name="RefreshForwardButton" Click="RefreshForwards"/></CommandBar.SecondaryCommands></CommandBar>
        <ListView x:Name="ForwardList" Grid.Row="1" SelectionMode="Single" AutomationProperties.Name="Port forwarding rules" SelectionChanged="ForwardSelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8" Spacing="2"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Binding}" TextWrapping="Wrap"/><TextBlock Text="{Binding State}"/><TextBlock Text="{Binding TelemetrySummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Error}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
       </Grid>
      </Grid>
     </Grid>

      <Thumb x:Name="ContextSidebarSplitter" Grid.Column="2" DragDelta="SidebarResize" DragCompleted="SidebarResizeCompleted" Background="{ThemeResource CardStrokeColorDefaultBrush}" AutomationProperties.Name="Resize navigation sidebar"/>

     <Grid x:Name="SettingsOverlay" Grid.Column="0" Grid.ColumnSpan="4" Visibility="Collapsed" Background="Transparent" AutomationProperties.Name="Settings overlay">
      <Grid x:Name="SettingsScrim" Background="#66000000"/>
      <Grid x:Name="SettingsSurface" Width="860" Height="616" Padding="0" Background="{ThemeResource WorkspaceBackgroundBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource CardCornerRadius}" HorizontalAlignment="Center" VerticalAlignment="Center" KeyDown="SettingsSurfaceKeyDown">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="12" Padding="20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SettingsHeading" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseSettingsButton" Grid.Column="1" Content="×" Click="CloseOverlay" AutomationProperties.Name="Close settings"/></Grid>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsNavigationColumn" Width="168"/><ColumnDefinition Width="*" MinWidth="0"/></Grid.ColumnDefinitions>
       <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="{ThemeResource ShellBackgroundBrush}"><StackPanel x:Name="SettingsNavigation" Spacing="2" Padding="8"><Button x:Name="SettingsPreferencesButton" Tag="general" Style="{StaticResource SettingsNavigationButtonStyle}" Click="ShowSettingsPreferences"/><Button x:Name="SettingsAppearanceButton" Tag="appearance" Style="{StaticResource SettingsNavigationButtonStyle}" Click="SettingsSectionClicked"/><Button x:Name="SettingsAiButton" Tag="ai" Style="{StaticResource SettingsNavigationButtonStyle}" Click="SettingsSectionClicked"/><Button x:Name="SettingsTerminalButton" Tag="terminal" Style="{StaticResource SettingsNavigationButtonStyle}" Click="SettingsSectionClicked"/><Button x:Name="SettingsSftpButton" Tag="sftp" Style="{StaticResource SettingsNavigationButtonStyle}" Click="SettingsSectionClicked"/><Button x:Name="SettingsSavedRefButton" Tag="savedRef" Style="{StaticResource SettingsNavigationButtonStyle}" Click="SettingsSectionClicked"/><Button x:Name="SettingsSecurityButton" Tag="security" Style="{StaticResource SettingsNavigationButtonStyle}" Click="SettingsSectionClicked"/><Button x:Name="SettingsLanSyncButton" Tag="lanSync" Style="{StaticResource SettingsNavigationButtonStyle}" Click="ShowLanSyncSettings"/><Button x:Name="SettingsShortcutsButton" Tag="shortcuts" Style="{StaticResource SettingsNavigationButtonStyle}" Click="SettingsSectionClicked"/><Button x:Name="SettingsAboutButton" Tag="about" Style="{StaticResource SettingsNavigationButtonStyle}" Click="ShowAbout"/></StackPanel></ScrollViewer>
       <Grid Grid.Column="1">
        <ScrollViewer x:Name="SettingsPage" Visibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Padding="20,16,20,24" Spacing="12" HorizontalAlignment="Stretch">
         <StackPanel x:Name="SettingsGeneralControls" Spacing="12"><ComboBox x:Name="LanguageChoice" SelectionChanged="LanguageChanged" MinWidth="150" HorizontalAlignment="Stretch"/></StackPanel>
         <StackPanel x:Name="SettingsAppearanceControls" Spacing="12" Visibility="Collapsed"><ComboBox x:Name="ThemeChoice" SelectionChanged="ThemeChanged" HorizontalAlignment="Stretch"/><ToggleSwitch x:Name="TransparencyChoice" Toggled="TransparencyChanged"/></StackPanel>
         <StackPanel x:Name="SettingsAiControls" Spacing="12" Visibility="Collapsed"><ComboBox x:Name="SettingsAiProviderChoice" HorizontalAlignment="Stretch"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SettingsConfigureAiButton" Click="NewAiProvider"/><Button x:Name="AiConfigureButton" Click="ConfigureAiProvider"/></StackPanel><StackPanel Spacing="8"><Button x:Name="AiTestButton" Click="TestAiProvider"/><Button x:Name="AiDiscoverButton" Click="DiscoverAiModels"/><Button x:Name="AiCapabilityButton" Click="TestAiCapability"/><Button x:Name="AiClearTokenButton" Click="ClearAiProviderToken"/><Button x:Name="AiDeleteProviderButton" Click="DeleteAiProvider"/></StackPanel></StackPanel>
         <ContentControl x:Name="PreferencesHost" HorizontalContentAlignment="Stretch"/>
         <StackPanel x:Name="SettingsSavedRefControls" Spacing="12" Visibility="Collapsed"><ComboBox x:Name="DefaultProxyChoice" SelectionChanged="DefaultProxyChanged" MinWidth="180" HorizontalAlignment="Stretch"/><Button x:Name="ManageKeysButton" Click="ManageKeys"/><Button x:Name="ManageProxiesButton" Click="ManageProxies"/><StackPanel x:Name="SettingsConnectionGroups" Spacing="8"><TextBlock x:Name="ConnectionGroupsHeading" FontWeight="SemiBold"/><ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="NewConnectionGroupButton" Click="NewConnectionGroup"/><Button x:Name="EditConnectionGroupButton" Click="EditConnectionGroup"/><Button x:Name="DeleteConnectionGroupButton" Click="DeleteConnectionGroup"/><Button x:Name="MoveConnectionGroupUpButton" Click="MoveConnectionGroupUp"/><Button x:Name="MoveConnectionGroupDownButton" Click="MoveConnectionGroupDown"/></StackPanel></ScrollViewer><ListView x:Name="ConnectionGroupsList" ItemsSource="{x:Bind ConnectionGroups.Groups}" DisplayMemberPath="Name" SelectionChanged="ConnectionGroupSelectionChanged" AutomationProperties.Name="Connection groups" MaxHeight="160"/></StackPanel></StackPanel>
         <StackPanel x:Name="SettingsSecurityControls" Spacing="12" Visibility="Collapsed"><Button x:Name="FinalShellImportButton" Click="ImportFinalShell"/><Button x:Name="SettingsImportButton" Click="ImportData"/><Button x:Name="SettingsExportButton" Click="ExportData"/><Button x:Name="ManageKnownHostsButton" Click="ManageKnownHosts"/><Button x:Name="ResetTrustButton" Click="ResetHostTrust"/></StackPanel>
         <StackPanel x:Name="SettingsShortcutControls" Spacing="16" Visibility="Collapsed"><StackPanel x:Name="ShortcutList" Spacing="14"/></StackPanel>
        </StackPanel></ScrollViewer>
        <Grid x:Name="LanSyncPage" Visibility="Collapsed" RowSpacing="12" Padding="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StartLanSyncButton" Click="StartLanSync"/><Button x:Name="StopLanSyncButton" Click="StopLanSync"/><TextBlock x:Name="LanSyncStatus" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><TextBlock x:Name="LanSyncCodeLabel" VerticalAlignment="Center"/><TextBlock x:Name="LanSyncCode" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></StackPanel>
         <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Button x:Name="ScanLanSyncButton" Click="ScanLanSync"/><TextBox x:Name="LanSyncHost" Grid.Column="1"/><NumberBox x:Name="LanSyncPort" Grid.Column="2" Minimum="1" Maximum="65535"/>
          <PasswordBox x:Name="LanSyncPairingCode" Grid.Row="1"/><ToggleSwitch x:Name="LanSyncIncludeSecrets" Grid.Row="1" Grid.Column="1"/><StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6"><Button x:Name="SendLanSyncButton" Click="SendLanSync"/><Button x:Name="CancelLanSyncButton" Click="CancelLanSync"/></StackPanel>
         </Grid>
         <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListView x:Name="LanSyncDevices" ItemsSource="{x:Bind LanSyncViewModel.Devices}" DisplayMemberPath="DeviceName" SelectionChanged="LanSyncDeviceChanged" AutomationProperties.Name="Nearby devices"/><StackPanel Grid.Column="1" Spacing="8"><TextBlock x:Name="LanSyncIncoming" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ApplyLanSyncButton" Click="ApplyLanSync"/><Button x:Name="RejectLanSyncButton" Click="RejectLanSync"/></StackPanel></StackPanel></Grid>
        </Grid>
        <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
         <StackPanel Spacing="16" MaxWidth="720">
          <Image x:Name="AboutLogo" Source="ms-appx:///Assets/OpenFinalShell.png" Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.Name="OpenFinalShell logo"/>
          <TextBlock x:Name="AboutProductName" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="AboutDescription" TextWrapping="Wrap"/>
          <StackPanel Spacing="6" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource CardCornerRadius}">
           <TextBlock x:Name="AboutVersion"/>
           <TextBlock x:Name="AboutEnvironment" TextWrapping="Wrap"/>
           <TextBlock Text="MIT License"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
           <ProgressRing x:Name="AboutUpdateProgressRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center"/>
           <Button x:Name="AboutChangelogButton" Click="OpenAboutChangelog"/>
           <Button x:Name="AboutCheckUpdatesButton" Click="CheckForUpdates"/>
           <HyperlinkButton x:Name="AboutGithubButton" Click="OpenAboutGithub"/>
          </StackPanel>
          <TextBlock x:Name="AboutUpdateStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Spacing="8" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource CardCornerRadius}"><TextBlock x:Name="UpdateHeading" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="UpdateCurrentLabel"/><ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CheckUpdatesButton" Click="CheckForUpdates"/><Button x:Name="DownloadUpdateButton" Click="DownloadUpdate"/><Button x:Name="InstallUpdateButton" Click="InstallUpdate"/><HyperlinkButton x:Name="UpdateReleaseNotesButton"/></StackPanel></ScrollViewer><ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100"/><StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing x:Name="UpdateProgressRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center"/><TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></StackPanel></StackPanel>
          <TextBlock x:Name="EnvironmentLabel" TextWrapping="Wrap"/>
          <StackPanel x:Name="DonateHost" Spacing="8" Margin="0,8,0,0"/>
         </StackPanel>
        </ScrollViewer>
       </Grid>
      </Grid>
     </Grid>

     </Grid>

     <Grid x:Name="AiPage" Grid.Column="0" Grid.ColumnSpan="4" Visibility="Collapsed" Background="Transparent" AutomationProperties.Name="AI assistant overlay">
      <Grid x:Name="AiScrim" Background="#66000000"/>
      <Grid x:Name="AiSurface" Width="820" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource WorkspaceBackgroundBrush}" Padding="20" RowSpacing="12" CornerRadius="{ThemeResource CardCornerRadius}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" KeyDown="SettingsSurfaceKeyDown">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AiHeading" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseAiButton" Grid.Column="1" Content="×" Click="CloseOverlay"/></Grid>
      <StackPanel Grid.Row="1" Spacing="12">
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AiProviderChoice" MaxWidth="360" HorizontalAlignment="Stretch" SelectionChanged="AiProviderChanged"/><Button x:Name="AiSettingsLink" Grid.Column="1" Click="OpenAiSettings"/></Grid>
       <StackPanel Spacing="4"><TextBlock x:Name="AiTargetLabel"/><ComboBox x:Name="AiTargetChoice" MaxWidth="360" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="AiTargetChanged"/><TextBlock x:Name="AiTargetWarning" TextWrapping="Wrap" Foreground="OrangeRed"/></StackPanel>
       <StackPanel Spacing="4"><TextBlock x:Name="AiResponseModeLabel"/><ComboBox x:Name="AiResponseModeChoice" MinWidth="180" SelectionChanged="AiResponseModeChanged"/></StackPanel>
      </StackPanel>
      <ListView x:Name="AiMessages" Grid.Row="2" AutomationProperties.Name="AI conversation" />
      <StackPanel Grid.Row="3" Spacing="8"><TextBox x:Name="AiInput" MinHeight="100" MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="AiInputChanged"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="AiImageButton" Click="SelectAiImage"/><Button x:Name="AiSendButton" Click="SendAiMessage"/><Button x:Name="AiCancelButton" Click="CancelAiMessage"/><Button x:Name="AiClearButton" Click="ClearAiConversation"/></StackPanel></StackPanel>
      </Grid>
     </Grid>
    </Grid>
    <Grid Grid.Row="3" Background="{ThemeResource ShellBackgroundBrush}" Padding="12,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StatusVersion" Grid.Column="1" FontSize="11" VerticalAlignment="Center" Opacity="0.7"/></Grid>
   </Grid>
 </Grid>
</Window>
