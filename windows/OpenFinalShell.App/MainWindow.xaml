<Window x:Class="OpenFinalShell.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ShellBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning" />
  <NavigationView x:Name="Navigation" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" SelectionChanged="NavigationChanged" ItemInvoked="NavigationItemInvoked" IsSettingsVisible="True" PaneTitle="OpenFinalShell">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="ConnectionsItem" Tag="connections" Icon="World" Tapped="NavigationMenuItemTapped"/>
    <NavigationViewItem x:Name="TransfersItem" Tag="transfers" Icon="Switch" Tapped="NavigationMenuItemTapped"/>
    <NavigationViewItem x:Name="CommandsItem" Tag="commands" Icon="Edit" Tapped="NavigationMenuItemTapped"/>
    <NavigationViewItem x:Name="ForwardItem" Tag="forwards" Icon="SwitchApps" Tapped="NavigationMenuItemTapped"/>
    <NavigationViewItem x:Name="AiItem" Tag="ai" Icon="Message" Tapped="NavigationMenuItemTapped"/>
    <NavigationViewItem x:Name="LanSyncItem" Tag="lansync" Icon="Link" Tapped="NavigationMenuItemTapped"/>
   </NavigationView.MenuItems>
   <Grid x:Name="Workspace" Margin="8" Background="{ThemeResource WorkspaceBackgroundBrush}" CornerRadius="{ThemeResource CardCornerRadius}">
    <Grid x:Name="ConnectionPage" Padding="16" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="NewButton" Click="NewConnection"/><Button x:Name="EditButton" Click="EditConnection"/><Button x:Name="DuplicateButton" Click="DuplicateConnection"/><Button x:Name="DeleteButton" Click="DeleteConnection"/><Button x:Name="ReconnectButton" Click="ReconnectSession"/><Button x:Name="ImportButton" Click="ImportData"/><Button x:Name="MigrationImportButton" Click="ImportData" Visibility="Collapsed"/><Button x:Name="ExportButton" Click="ExportData"/></StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="ConnectionSortChoice" Width="220" SelectionChanged="ConnectionSortChanged"/><ComboBox x:Name="ConnectionGroupingChoice" Width="220" SelectionChanged="ConnectionGroupingChanged"/></StackPanel>
     <ListView x:Name="ProfilesList" Grid.Row="2" MaxHeight="180" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OpenConnection" SelectionChanged="ProfileSelectionChanged" AutomationProperties.Name="Connections"/>
     <Grid Grid.Row="3" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabView x:Name="Sessions" IsAddTabButtonVisible="False" TabCloseRequested="SessionCloseRequested" SelectionChanged="SessionSelectionChanged"/><ContentControl x:Name="SessionContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Grid>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel Padding="{ThemeResource CardPadding}" Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
     <TextBlock x:Name="SettingsHeading" FontSize="24" FontWeight="SemiBold"/>
     <ComboBox x:Name="ThemeChoice" SelectionChanged="ThemeChanged" HorizontalAlignment="Stretch"/>
     <ComboBox x:Name="LanguageChoice" SelectionChanged="LanguageChanged" HorizontalAlignment="Stretch"/>
     <ToggleSwitch x:Name="TransparencyChoice" Toggled="TransparencyChanged"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ManageKeysButton" Click="ManageKeys"/><Button x:Name="ManageProxiesButton" Click="ManageProxies"/><Button x:Name="ManageKnownHostsButton" Click="ManageKnownHosts"/></StackPanel>
     <TextBlock x:Name="ConnectionGroupsHeading" FontWeight="SemiBold"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="NewConnectionGroupButton" Click="NewConnectionGroup"/><Button x:Name="EditConnectionGroupButton" Click="EditConnectionGroup"/><Button x:Name="DeleteConnectionGroupButton" Click="DeleteConnectionGroup"/><Button x:Name="MoveConnectionGroupUpButton" Click="MoveConnectionGroupUp"/><Button x:Name="MoveConnectionGroupDownButton" Click="MoveConnectionGroupDown"/></StackPanel>
     <ListView x:Name="ConnectionGroupsList" ItemsSource="{x:Bind ConnectionGroups.Groups}" DisplayMemberPath="Name" SelectionChanged="ConnectionGroupSelectionChanged" AutomationProperties.Name="Connection groups" MaxHeight="160"/>
     <TextBlock x:Name="EnvironmentLabel" TextWrapping="Wrap"/>
     <StackPanel Spacing="8" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource CardCornerRadius}">
      <TextBlock x:Name="UpdateHeading" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="UpdateCurrentLabel"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Button x:Name="CheckUpdatesButton" Click="CheckForUpdates"/>
       <Button x:Name="DownloadUpdateButton" Click="DownloadUpdate"/>
       <Button x:Name="InstallUpdateButton" Click="InstallUpdate"/>
       <HyperlinkButton x:Name="UpdateReleaseNotesButton"/>
      </StackPanel>
      <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100"/>
      <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <Button x:Name="ResetTrustButton" Click="ResetHostTrust"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="TransfersPage" Visibility="Collapsed" Padding="16" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PauseTransferButton" Click="PauseTransfer"/><Button x:Name="ResumeTransferButton" Click="ResumeTransfer"/><Button x:Name="RetryTransferButton" Click="RetryTransfer"/><Button x:Name="CancelTransferButton" Click="CancelTransfer"/><Button x:Name="ClearTransferButton" Click="ClearFinishedTransfers"/></StackPanel>
     <ListView x:Name="TransferList" Grid.Row="1" SelectionMode="Single" DisplayMemberPath="Summary" AutomationProperties.Name="Transfer queue"/>
    </Grid>
    <Grid x:Name="CommandsPage" Visibility="Collapsed" Padding="16" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="NewGroupButton" Click="NewCommandGroup"/><Button x:Name="EditGroupButton" Click="EditCommandGroup"/><Button x:Name="DeleteGroupButton" Click="DeleteCommandGroup"/><Button x:Name="NewSnippetButton" Click="NewCommandSnippet"/><Button x:Name="EditSnippetButton" Click="EditCommandSnippet"/><Button x:Name="DuplicateSnippetButton" Click="DuplicateCommandSnippet"/><Button x:Name="DeleteSnippetButton" Click="DeleteCommandSnippet"/><Button x:Name="SendSnippetButton" Click="SendSelectedSnippet"/><Button x:Name="ClearHistoryButton" Click="ClearCommandHistory"/></StackPanel>
     <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListView x:Name="CommandGroups" ItemsSource="{x:Bind CommandViewModel.Groups}" DisplayMemberPath="Name" SelectionChanged="CommandGroupChanged" AutomationProperties.Name="Command groups"/><ListView x:Name="CommandSnippets" Grid.Column="1" ItemsSource="{x:Bind CommandViewModel.Snippets}" DisplayMemberPath="Name" SelectionChanged="CommandSnippetChanged" IsItemClickEnabled="True" ItemClick="CommandSnippetClicked" AutomationProperties.Name="Commands"/></Grid>
     <ListView x:Name="CommandHistory" Grid.Row="2" ItemsSource="{x:Bind CommandViewModel.History}" AutomationProperties.Name="Command history"/>
    </Grid>
    <Grid x:Name="AiPage" Visibility="Collapsed" Padding="16" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="AiProviderChoice" Width="280" SelectionChanged="AiProviderChanged"/><Button x:Name="AiTestButton" Click="TestAiProvider"/><Button x:Name="AiDiscoverButton" Click="DiscoverAiModels"/><Button x:Name="AiCapabilityButton" Click="TestAiCapability"/><Button x:Name="AiConfigureButton" Click="ConfigureAiProvider"/></StackPanel>
     <ListView x:Name="AiMessages" Grid.Row="1" Grid.RowSpan="2" AutomationProperties.Name="AI conversation"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="6" Spacing="4"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><Image Source="{Binding PreviewImage}" MaxHeight="180" MaxWidth="320" Stretch="Uniform"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"><TextBox x:Name="AiInput" Width="560" PlaceholderText="Message"/><Button x:Name="AiImageButton" Click="SelectAiImage"/><Button x:Name="AiSendButton" Click="SendAiMessage"/><Button x:Name="AiCancelButton" Click="CancelAiMessage"/><Button x:Name="AiClearButton" Click="ClearAiConversation"/></StackPanel>
    </Grid>
    <Grid x:Name="ForwardPage" Visibility="Collapsed" Padding="16" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="NewForwardButton" Click="NewForward"/><Button x:Name="EditForwardButton" Click="EditForward"/><Button x:Name="DeleteForwardButton" Click="DeleteForward"/><Button x:Name="StartForwardButton" Click="StartForward"/><Button x:Name="StopForwardButton" Click="StopForward"/><Button x:Name="RefreshForwardButton" Click="RefreshForwards"/></StackPanel>
     <ListView x:Name="ForwardList" Grid.Row="1" SelectionMode="Single" AutomationProperties.Name="Port forwarding rules" SelectionChanged="ForwardSelectionChanged">
      <ListView.ItemTemplate><DataTemplate><StackPanel Padding="8" Spacing="2"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Binding}"/><TextBlock Text="{Binding State}"/><TextBlock Text="{Binding TelemetrySummary}"/><TextBlock Text="{Binding Error}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
    <Grid x:Name="LanSyncPage" Visibility="Collapsed" Padding="16" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StartLanSyncButton" Click="StartLanSync"/><Button x:Name="StopLanSyncButton" Click="StopLanSync"/><TextBlock x:Name="LanSyncStatus" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><TextBlock x:Name="LanSyncCodeLabel" VerticalAlignment="Center"/><TextBlock x:Name="LanSyncCode" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></StackPanel>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button x:Name="ScanLanSyncButton" Click="ScanLanSync"/><TextBox x:Name="LanSyncHost" Width="180"/><NumberBox x:Name="LanSyncPort" Width="120" Minimum="1" Maximum="65535"/><PasswordBox x:Name="LanSyncPairingCode" Width="140"/><ToggleSwitch x:Name="LanSyncIncludeSecrets"/><Button x:Name="SendLanSyncButton" Click="SendLanSync"/><Button x:Name="CancelLanSyncButton" Click="CancelLanSync"/></StackPanel>
     <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListView x:Name="LanSyncDevices" ItemsSource="{x:Bind LanSyncViewModel.Devices}" DisplayMemberPath="DeviceName" SelectionChanged="LanSyncDeviceChanged" AutomationProperties.Name="Nearby devices"/><StackPanel Grid.Column="1" Spacing="8"><TextBlock x:Name="LanSyncIncoming" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ApplyLanSyncButton" Click="ApplyLanSync"/><Button x:Name="RejectLanSyncButton" Click="RejectLanSync"/></StackPanel></StackPanel></Grid>
    </Grid>
    <StackPanel x:Name="FeaturePage" Visibility="Collapsed" Padding="24" Spacing="16"><TextBlock x:Name="FeatureHeading" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="FeatureDescription" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </NavigationView>
  <TextBlock x:Name="Status" Grid.Row="2" Margin="12,4" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
