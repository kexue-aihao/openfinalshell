{
  "name": "openfinalshell",
  "version": "0.6.0",
  "description": "开源 FinalShell —— SSH 终端 + SFTP + 服务器监控三合一的桌面客户端",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "openfinalshell contributors",
  "license": "MIT",
  "homepage": "https://github.com/openfinalshell/openfinalshell",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:i18n": "node scripts/checkI18n.mjs",
    "test": "vitest run",
    "icon": "node scripts/generateIcon.mjs",
    "package": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --win --dir",
    "smoke:packaged": "node test/fixtures/packagedSmoke.mjs",
    "postinstall": "electron-builder install-app-deps",
    "check:bundle": "node scripts/checkBundleBudget.mjs"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "~0.10.0",
    "@xterm/addon-search": "~0.15.0",
    "@xterm/addon-unicode11": "~0.8.0",
    "@xterm/addon-web-links": "~0.11.0",
    "@xterm/addon-webgl": "~0.18.0",
    "@xterm/xterm": "~5.5.0",
    "antd": "^5.29.3",
    "echarts": "^5.6.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-resizable-panels": "^2.1.9",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  }
}
